# Copy to .env for local development and fill in real values. Never commit .env.
MONGODB_URI=mongodb://localhost:27017/journaldb
MONGODB_DATABASE=journaldb
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
REDIS_URL=redis://localhost:6379
WEATHER_API_KEY=
